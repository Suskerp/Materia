{
  "name": "materia",
  "version": "0.71.1",
  "description": "Material You / Expressive card collection for Home Assistant",
  "main": "dist/materia.js",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c --watch",
    "test": "node --test",
    "check:source": "node scripts/check-source.mjs",
    "check:version": "node scripts/check-version.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check": "npm run check:source && npm run check:version && npm test && npm run build && npm run check:bundle"
  },
  "keywords": [
    "home-assistant",
    "lovelace",
    "material-you",
    "custom-card"
  ],
  "type": "module",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.2.0",
    "@rollup/plugin-terser": "^0.4.0",
    "rollup": "^4.9.0",
    "rollup-plugin-serve": "^2.0.0"
  },
  "dependencies": {
    "lit": "^3.1.0"
  }
}
